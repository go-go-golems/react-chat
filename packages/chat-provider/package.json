{
  "name": "@go-go-golems/chat-provider",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./store": "./src/store/store.ts",
    "./tools": "./src/tools/index.ts",
    "./widgets": "./src/widgets/index.ts",
    "./ws": "./src/ws/index.ts",
    "./debug": "./src/debug/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "build:dist": "node ../../scripts/packages/build-dist.mjs",
    "test": "vitest run src --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "react-redux": "^9.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.2"
  },
  "description": "Provider runtime, state, websocket, tool, and widget primitives for embeddable React chat.",
  "license": "MIT",
  "author": "Manuel Odendahl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/go-go-golems/react-chat.git",
    "directory": "packages/chat-provider"
  },
  "homepage": "https://github.com/go-go-golems/react-chat/tree/main/packages/chat-provider#readme",
  "bugs": {
    "url": "https://github.com/go-go-golems/react-chat/issues"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.css",
    "**/*.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "keywords": [
    "react",
    "chat",
    "websocket",
    "tools",
    "widgets",
    "go-go-golems"
  ]
}
